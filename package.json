{
  "name": "holdtdeord",
  "private": true,
  "description": "Byggeverktøy for HoldtDeOrd.no (kompilerer Tailwind CSS til assets/tailwind.css)",
  "scripts": {
    "build": "tailwindcss --postcss -c tailwind.config.js -i src/tailwind.css -o assets/tailwind.css --minify",
    "watch": "tailwindcss --postcss -c tailwind.config.js -i src/tailwind.css -o assets/tailwind.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17"
  },
  "browserslist": [
    "defaults",
    "safari >= 12",
    "ios_saf >= 12"
  ]
}
